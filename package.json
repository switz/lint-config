{
  "name": "@switz/lint-config",
  "version": "1.0.0",
  "description": "Shared oxlint and oxfmt configs",
  "type": "module",
  "exports": {
    ".": "./oxlint.json",
    "./oxlint": "./oxlint.json",
    "./oxlint/react": "./oxlint.react.json",
    "./oxlint/tailwind": "./oxlint.tailwind.json",
    "./oxfmt": "./.oxfmtrc.json"
  },
  "files": [
    "oxlint.json",
    "oxlint.react.json",
    "oxlint.tailwind.json",
    ".oxfmtrc.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/switz/lint-config.git"
  },
  "homepage": "https://github.com/switz/lint-config#readme",
  "bugs": "https://github.com/switz/lint-config/issues",
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "oxlint": ">= 0.16",
    "oxfmt": ">= 0.1",
    "oxlint-tailwindcss": "*"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "oxlint-tailwindcss": {
      "optional": true
    }
  }
}
